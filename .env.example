# signum-adapters 환경변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   .env 파일에 실제 값 입력 후 사용
#
# ⚠️ .env 파일은 절대 커밋하지 말 것 (gitignore 처리됨)

# ── 레포 OUT: 시크릿 (반드시 설정 필요) ──────────────────────────────────
GMO_COIN_API_KEY=           # GMO Coin API 키 (필수)
GMO_COIN_API_SECRET=        # GMO Coin API 시크릿 (필수)

# ── 아래는 기본값이 있으므로 선택적 override ─────────────────────────────
# GMO_COIN_BASE_URL=https://api.coin.z.com
# REQUEST_TIMEOUT=30
# LOG_LEVEL=INFO
